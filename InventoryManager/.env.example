# Copy to .env. Keep .env outside Git and replace every blank secret/URL.

# App and bootstrap business database (app and worker)
FLASK_ENV=production
DATABASE_URL=
SECRET_KEY=
SAAS_MASTER_KEY=

# SaaS control database and tenant database routing
CONTROL_DATABASE_URL=
TENANT_DB_HOST=
TENANT_DB_PORT=3306
TENANT_DB_NAME_PREFIX=inventory_tenant_
TENANT_DB_USER_PREFIX=im_t
CONTROL_DB_POOL_SIZE=5
TENANT_DB_POOL_SIZE=2

# App-only database authority; omit from the worker environment
PROVISIONER_DATABASE_URL=

# Cookie, proxy and exact credentialed CORS origins
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
TRUSTED_PROXY_HOPS=0
CORS_ORIGINS=

# Tencent Cloud SMS (app only)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# Global Xianyu API endpoint (shop credentials are stored per tenant)
XIANYU_API_DOMAIN=open.goofish.pro

# Logging
LOG_LEVEL=INFO

# One-shot default-tenant migration only. Delete these keys after adoption.
# SF_PARTNER_ID=
# SF_CHECKWORD=
# SF_MONTHLY_CARD=
# SF_SENDER_NAME=
# SF_SENDER_PHONE=
# SF_SENDER_ADDRESS=
# SF_TEST_MODE=
